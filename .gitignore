# Git ignore rules for open-source research workspace

# 1. 忽略所有非 Submodule 的第三方目录（只留 6 个官方 submodule）
# 保持对 6 个官方 Submodule 路径的追踪：
third_party/*
!third_party/vllm/

huawei/third_party/*
!huawei/third_party/vllm-ascend/

qualcomm/third_party/*
!qualcomm/third_party/vllm-qaic/

tenstorrent/third_party/*
!tenstorrent/third_party/vllm-tt-plugin/
!tenstorrent/third_party/tt-metal/

google/third_party/*
!google/third_party/tpu-inference/

# 2. Python 缓存与临时文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. 编辑器与 IDE 配置
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 4. 日志与临时调试文件
*.log
/tmp/
