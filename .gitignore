# Git ignore rules for open-source research workspace

# 1. 忽略构建产物与开发临时文件夹
**/build/
**/dist/
**/CMakeFiles/
**/*.egg-info/
**/*.egg

# 2. Python 缓存与二进制文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg

# 3. 编辑器与 IDE 配置
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 4. 日志与临时调试文件
*.log
/tmp/
